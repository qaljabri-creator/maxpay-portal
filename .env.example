# Copy to .env and fill in. .env is never committed.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (spec §Stack) -------------------------------------------
POSTGRES_DB=maxpay
POSTGRES_USER=maxpay
POSTGRES_PASSWORD=maxpay
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional single-URL override. Takes precedence over the POSTGRES_* vars.
#   postgres://user:pass@host:5432/dbname
# A sqlite:// URL is accepted for local smoke-testing only — never for any
# shared or production environment.
# DATABASE_URL=postgres://maxpay:maxpay@127.0.0.1:5432/maxpay

# --- Two-factor authentication ------------------------------------------
OTP_TOTP_ISSUER=MaxPay Portal

# --- B2CORE embed and client authentication (spec §4) --------------------
# Origin of the B2CORE portal that frames us. Scheme + host, no trailing path:
# the frame-ancestors CSP and every postMessage target origin are built from it.
B2CORE_ORIGIN=https://portal.example.com
B2CORE_JWKS_URL=https://api.example.com/.well-known/jwks.json

# Verified when set, skipped when blank. Leaving either empty accepts any
# correctly-signed token regardless of who issued it or who it was meant for;
# `manage.py check` says so at start-up. Ask B2CORE for the exact values.
# B2CORE_JWT_ISSUER=https://api.example.com
# B2CORE_JWT_AUDIENCE=maxpay-portal

# Asymmetric only. An HMAC entry here would turn the published JWKS public key
# into a signing key for anyone who fetched it.
# B2CORE_JWT_ALGORITHMS=RS256,RS512,ES256
# B2CORE_JWT_LEEWAY_SECONDS=30
# B2CORE_ACCOUNT_CLAIM=account_number

# --- The embedded client portal -----------------------------------------
# A cookie of its own, separate from the internal panel's session. It lives in
# a third-party iframe, so it needs SameSite=None; the internal one stays Lax
# and must never be relaxed to match. `manage.py check` refuses a collision.
# PORTAL_SESSION_COOKIE_NAME=maxpay_embed_sid
# PORTAL_SESSION_COOKIE_SAMESITE=None
#
# SameSite=None is dropped outright by browsers unless the cookie is Secure, so
# testing the embed needs HTTPS. Set this to false ONLY for local work over
# http, and never anywhere shared.
# PORTAL_SESSION_COOKIE_SECURE=true
# PORTAL_SESSION_MAX_SECONDS=28800
# PORTAL_SESSION_RATE=30/minute
#
# Lets the bootstrap page run outside an iframe. Local development only.
# PORTAL_ALLOW_STANDALONE=false

# --- The client request flow (build-order step 6) -----------------------
# Spec §11: rate limiting on the submission endpoints. The catalogue limit is
# far looser because it is read-only and a client legitimately re-asks it on
# every step of the wizard.
# PORTAL_SUBMISSION_RATE=20/hour
# PORTAL_CATALOG_RATE=240/minute
#
# Bounds on one deposit, in USD. PLACEHOLDERS — the spec names no figure, and
# these only stop a zero or an overflow. Confirm the real limits with Finance
# before go-live and set them per environment.
# PORTAL_DEPOSIT_MIN_USD=1
# PORTAL_DEPOSIT_MAX_USD=100000

# --- The withdrawal flow (build-order step 10) --------------------------
# Bounds on one withdrawal, in USD. Kept apart from the deposit pair because
# the directions are not symmetric — a withdrawal spends money a merchant has
# to have on hand. Same caveat: placeholders, confirm with Finance.
# PORTAL_WITHDRAWAL_MIN_USD=1
# PORTAL_WITHDRAWAL_MAX_USD=100000
#
# How long a destination card or wallet number may be, in digits, once the
# spaces and dashes a client types are stripped. A typo guard, not a checksum.
# PORTAL_DESTINATION_MIN_DIGITS=6
# PORTAL_DESTINATION_MAX_DIGITS=32
#
# How long a signed attachment URL stays valid. Short on purpose: the request
# view re-signs on every load, so a link is never meant to be kept.
# PORTAL_ATTACHMENT_URL_MAX_AGE=300
# PORTAL_MESSAGE_MAX_CHARS=1000
#
# Posting into a request thread (build-order step 9). Looser than the
# submission limit because a conversation is meant to be had.
# PORTAL_MESSAGE_RATE=30/minute

# --- Live updates (build-order step 13) ---------------------------------
#
# How often the two internal panels ask the server whether anything moved.
# Spec §10 says ten seconds; widen it if a deployment is under load. A deploy
# check complains below 2 or above 120.
# PANEL_POLL_SECONDS=10

# --- Security hardening (build-order step 14) ---------------------------
#
# **Set this in any environment with more than one worker process.** Both rate
# limiters — the portal's submission limit (spec §11) and the internal login
# lockout — are counters in the cache. Without a shared cache each worker
# enforces its own private allowance, which is to say neither is a limit.
# `manage.py check --deploy` reports core.W010 while it is unset.
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_KEY_PREFIX=maxpay
#
# The internal login lockout. Counted per (email, IP) pair: per-email alone
# would let anyone lock a colleague out of their own account.
# LOGIN_FAILURE_LIMIT=10
# LOGIN_FAILURE_WINDOW_SECONDS=900
#
# Where `manage.py backup_database` writes (spec §11: daily backups, restore
# tested before go-live). Point it at a volume that does not share a failure
# domain with the database — a dump on the same disk is not a backup of
# anything that takes the disk with it. The command does not encrypt and does
# not copy off-host; that belongs to whatever the deployment already uses.
# BACKUP_DIR=/srv/maxpay/backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_TIMEOUT_SECONDS=1800

# --- Trying it locally in a browser -------------------------------------
# `python manage.py seed_demo` seeds demo data and stands up a local stand-in
# for B2CORE — a dev RSA key, the JWKS a real endpoint would publish, and one
# signed token. It prints the exact block to paste here; it is roughly:
#
#   B2CORE_ORIGIN=http://127.0.0.1:8000
#   B2CORE_JWKS_URL=http://127.0.0.1:8000/static/dev/b2core-jwks.json
#   B2CORE_JWT_ISSUER=https://b2core.local
#   B2CORE_JWT_AUDIENCE=maxpay-portal
#   PORTAL_ALLOW_STANDALONE=true
#   PORTAL_SESSION_COOKIE_SAMESITE=Lax
#   PORTAL_SESSION_COOKIE_SECURE=false
#
# The last two are what let the portal cookie survive plain http on localhost.
# Every one of these is a local-only value; none belongs in a shared .env.
